{
  "name": "cnke-claw",
  "version": "1.4.2",
  "description": "CnkeIDE - 独立 Electron 桌面 AI 编程 IDE",
  "author": "CnkeIDE",
  "license": "MIT",
  "main": "renderer/dist-electron/main.js",
  "bin": {
    "cnkeide": "dist-cli/cnkeide.cjs"
  },
  "scripts": {
    "dev": "vite",
    "dev:vite": "vite",
    "build": "tsc -p electron/tsconfig.json && vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p electron/tsconfig.json --noEmit",
    "typecheck:cli": "tsc -p cli/tsconfig.json --noEmit",
    "typecheck:renderer": "tsc -p renderer/tsconfig.json --noEmit",
    "preview": "vite preview",
    "test": "npm run test:all",
    "test:headless": "node scripts/build-cli.mjs && node scripts/test-headless-e2e.mjs",
    "test:agent": "tsx scripts/test_w10_rag.mjs && tsx scripts/test_w12_browser_image.mjs",
    "test:all": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/run_all_w1_w16.ps1",
    "pack": "npm run build && electron-builder --config electron-builder.json",
    "pack:win": "npm run build && electron-builder --win --config electron-builder.json",
    "pack:mac": "npm run build && electron-builder --mac --config electron-builder.json",
    "pack:linux": "npm run build && electron-builder --linux --config electron-builder.json"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-cpp": "^6.0.3",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-go": "^6.0.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-java": "^6.0.2",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-php": "^6.0.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-rust": "^6.0.2",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.11",
    "@modelcontextprotocol/sdk": "^1.0.4",
    "adm-zip": "^0.6.0",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.9",
    "esbuild": "^0.28.2",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.400.0",
    "nanoid": "^5.0.7",
    "pptxgenjs": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.0.20",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sherpa-onnx-node": "^2.0.1",
    "sherpa-onnx-win-x64": "^2.0.1",
    "xlsx": "^0.18.5",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^15.15.0",
    "playwright": "^1.63.0",
    "png-to-ico": "^3.0.2",
    "png2icons": "^2.0.1",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^5.3.4",
    "vite-plugin-electron": "^0.28.0",
    "vite-plugin-electron-renderer": "^0.14.5",
    "wait-on": "^7.2.0"
  }
}
